<div class="container">
  <h1>Tasks</h1>

  <%= link_to "New Task", new_task_path, class: "btn btn-primary" %>

  <% if @tasks.any? %>
    <%= render partial: 'task', collection: @tasks, cached: true %>
  <% else %>
    <p>No tasks yet. <%= link_to "Create one!", new_task_path %></p>
  <% end %>
</div>
