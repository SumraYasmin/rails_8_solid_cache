<div class="task-card">
  <%= link_to task.title, task, class: "task-title" %>
  <p><%= truncate(task.description, length: 150) %></p>
  <small>Created <%= time_ago_in_words(task.created_at) %> ago</small>
  <div style="margin-top: 10px;">
    <%= link_to "View", task, class: "btn btn-primary" %>
    <%= link_to "Edit", edit_task_path(task), class: "btn btn-secondary" %>
    <%= button_to "Delete", task, method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "btn btn-danger" %>
  </div>
</div>
